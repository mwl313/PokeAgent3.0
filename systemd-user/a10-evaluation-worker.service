[Unit]
Description=A10 CPU batched battle worker and best policy manager

[Service]
Type=simple
WorkingDirectory=/home/minidc/Desktop/PokeAgent3.0-A-evaluation-league
Environment=CUDA_VISIBLE_DEVICES=
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
Nice=10
IOSchedulingClass=idle
CPUAffinity=16 17 18 19
CPUQuota=400%
MemoryHigh=2G
MemoryMax=3G
ExecStart=/home/minidc/Desktop/PokeAgent3.0/PokeAgent3.0-agent1-pa3/.venv/bin/python /home/minidc/Desktop/PokeAgent3.0-A-evaluation-league/scripts/a10_evaluation_worker.py --run-root /home/minidc/Desktop/PokeAgent3.0-A/runs/a10_production_20261013_v2 --batch-size 16 --threads 2 --workers 2
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
