            "properties": {
              "source_tabs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "const": "User Submission"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "provider": {
                "const": "VGCPastes"
              }
