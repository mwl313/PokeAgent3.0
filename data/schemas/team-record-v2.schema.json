        "moves": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allocation": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "raw_line",
            "source_unit",
            "unit_evidence",
            "parsed_values",
            "engine_values",
            "conversion"
          ],
          "properties": {
            "raw_line": {
              "type": "string",
              "minLength": 1
            },
            "source_unit": {
              "enum": [
                "champions_stat_points",
                "legacy_evs"
              ]
            },
            "unit_evidence": {
              "type": "string",
              "minLength": 1
            },
            "parsed_values": {
              "$ref": "#/$defs/stats"
            },
            "engine_values": {
              "$ref": "#/$defs/stats"
            },
            "conversion": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "none",
                    "documented_exact_source_mapping"
                  ]
                },
                "mapping_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "stats_at_battle_start": {
          "$ref": "#/$defs/stats"
        },
        "format_defaults": {
          "type": "object"
        },
        "raw_export_block": {
          "type": "string"
        }
      }
    }
  },
  "x-semantic-validation": [
    "Infer no hidden/missing allocation.",
    "Allocation bounds are determined by the pinned format, not generic EV limits.",
    "Absent item key differs from a deliberate no-item entry.",
    "Species/Item clauses and move legality require the reference validator.",
    "Groups do not cross splits.",
    "Actual original source links and permission conditions must be preserved.",
    "user_submitted_pokepaste records are one explicitly approved manual source; they are never presented as VGCPastes collection records.",
    "A reference_validator_base_form_default ability resolution records both the declared Mega-form ability and the resolved base-form ability, and is flagged for user confirmation."
  ],
  "allOf": [
    {
      "if": {
