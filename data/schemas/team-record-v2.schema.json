        "def": {
          "type": "integer",
          "minimum": 0
        },
        "spa": {
          "type": "integer",
          "minimum": 0
        },
        "spd": {
          "type": "integer",
          "minimum": 0
        },
        "spe": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "species",
        "ability",
        "item",
        "nature",
        "moves",
        "allocation",
        "stats_at_battle_start",
        "format_defaults"
      ],
      "properties": {
        "species": {
          "type": "string",
          "minLength": 1
        },
        "ability": {
          "type": "string",
          "minLength": 1
        },
        "item": {
          "type": [
            "string",
            "null"
          ]
        },
        "nature": {
          "type": "string",
          "minLength": 1
