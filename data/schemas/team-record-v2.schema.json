          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": "pa3-team-v1"
          },
          "source": {
            "properties": {
              "source_tabs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "Champions M-A",
                    "Champions M-B",
                    "Champions M-C"
