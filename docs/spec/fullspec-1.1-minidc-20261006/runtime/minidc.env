# PokeAgent 3.0 MiniDC process-local settings. Source from an approved project shell.
# Does NOT install packages, unload models, change host services, change power, or launch training.
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0,1
export CUDA_HOME=/usr/local/cuda-12.8
export TORCH_CUDA_ARCH_LIST=7.0
export NCCL_P2P_DISABLE=1
export NCCL_SHM_DISABLE=0
export TORCHDYNAMO_DISABLE=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export RAYON_NUM_THREADS=16
# Do not rewrite LD_LIBRARY_PATH or the /usr/local/cuda symlink.
# The trainer must use eager SDPA math, FP16 autocast and FP32 critical arithmetic.
# Bind each rank and its engine workers to its GPU-local NUMA node in the launcher.
